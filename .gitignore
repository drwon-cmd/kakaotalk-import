# 카카오톡 원본 대화 파일 (개인정보 포함 가능)
raw/**/*.txt
!raw/**/.gitkeep

# 카카오톡 내보내기 — 모든 폴더 (업무보고/ 포함). 2026-06-15 히스토리 정리 후 재추적 차단
KakaoTalk_*.txt
KakaoTalk_*.zip
KakaoTalk_*.csv

# 생성된 요약 파일 (개인정보 포함 가능)
summaries/**/*.md
summaries/**/*.pdf
!summaries/**/.gitkeep

# 분석 결과 파일 (개인정보 포함)
analysis/outputs/**/*.md
analysis/outputs/**/*.json
!analysis/outputs/.gitkeep

# 임시 파일
*.tmp
temp.md
*.bak

# OS 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Node.js (md-to-pdf 관련)
node_modules/
package-lock.json

# 로그 파일
*.log
